{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/api/public",
  "functions": {
    "apps/api/dist/index.js": {
      "includeFiles": "apps/api/public/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/dist/index.js" },
    { "src": "/health", "dest": "apps/api/dist/index.js" },
    { "src": "/api/health", "dest": "apps/api/dist/index.js" },
    { "src": "/manifest.webmanifest", "dest": "apps/api/public/manifest.webmanifest" },
    { "src": "/sw.js", "dest": "apps/api/public/sw.js" },
    { "src": "/assets/(.*)", "dest": "apps/api/public/assets/$1" },
    { "src": "/(.*)", "dest": "apps/api/public/index.html" }
  ],
  "env": {
    "USE_PGLITE": "true",
    "SMS_PROVIDER": "mock"
  }
}
