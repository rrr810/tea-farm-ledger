{
  "buildCommand": "npx tsc --build && npx vite build apps/supervisor-pwa && mkdir -p apps/api/public && cp -r apps/supervisor-pwa/dist/* apps/api/public/",
  "outputDirectory": "apps/api/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/dist/**, packages/**/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/friday-estimate", "schedule": "0 14 * * 5" },
    { "path": "/api/cron/saturday-reminder", "schedule": "30 11 * * 6" }
  ],
  "env": {
    "REQUIRED_CRON_SECRET": "true"
  }
}
