{
  "buildCommand": "npm run build && mkdir -p apps/api/public && cp -r apps/supervisor-pwa/dist/* apps/api/public/",
  "outputDirectory": "apps/api/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/dist/**, packages/**, node_modules/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/api/health", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
