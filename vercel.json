{
  "buildCommand": "npm run typecheck && npx vite build apps/supervisor-pwa && npx vite build apps/admin-web && mkdir -p apps/api/public && cp -r apps/supervisor-pwa/dist/* apps/api/public/ && mkdir -p apps/api/public/admin && cp -r apps/admin-web/dist/* apps/api/public/admin/",
  "outputDirectory": "apps/api/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/dist/**, packages/**/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/friday-estimate",
      "schedule": "0 14 * * 5"
    },
    {
      "path": "/api/cron/saturday-reminder",
      "schedule": "30 11 * * 6"
    }
  ],
  "env": {
    "REQUIRED_CRON_SECRET": "true"
  }
}
