NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
# Persistent Postgres default — used when DATABASE_URL is not set. In production
# this MUST be set to a real Postgres URL; PGlite is refused in production.
DATABASE_URL=postgresql://tea_ledger:tea_ledger_dev@localhost:5432/tea_ledger
# Set to true only for tests/local PGlite fallback. Never true in production.
USE_PGLITE=false
# Cron protection — REQUIRED_CRON_SECRET=true makes CRON_SECRET mandatory.
CRON_SECRET=change-me-set-a-long-random-value
REQUIRED_CRON_SECRET=false
SESSION_SECRET=change-me-to-32-plus-random-chars
ADMIN_DEFAULT_PASSWORD=change-me
SMS_PROVIDER=mock
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=TEAFARM
SMS_SANDBOX=true
# Mobile Sasa delivery-report lookup is read-only and is used only for already
# accepted live-daily messages. Do not commit a real token.
MOBILESASA_TOKEN=
# Optional real-time Mobile Sasa DLR callback. Set this only after copying the
# matching secret from the Mobile Sasa Webhooks settings into deployment env.
MOBILESASA_WEBHOOK_SECRET=
