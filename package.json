{
  "name": "tea-farm-ledger",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npx --yes --package=typescript tsc --build tsconfig.json",
    "vercel-build": "npm run build && npm run build:pwa && npm run build:admin && npm run build:api-public",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "npm run dev --workspace=@tea-ledger/api",
    "dev:pwa": "npm run dev --workspace=@tea-ledger/supervisor-pwa",
    "dev:admin": "npm run dev --workspace=@tea-ledger/admin-web",
    "seed": "tsx scripts/seed-demo.ts",
    "build:pwa": "vite build apps/supervisor-pwa",
    "build:admin": "vite build apps/admin-web",
    "build:api-public": "mkdir -p apps/api/public && cp -r apps/supervisor-pwa/dist/* apps/api/public/ && mkdir -p apps/api/public/admin && cp -r apps/admin-web/dist/* apps/api/public/admin/",
    "migrate": "npm run migrate --workspace=@tea-ledger/database"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
