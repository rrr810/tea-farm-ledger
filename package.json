{
  "name": "tea-farm-ledger",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "npm run dev --workspace=@tea-ledger/api",
    "dev:pwa": "npm run dev --workspace=@tea-ledger/supervisor-pwa",
    "dev:admin": "npm run dev --workspace=@tea-ledger/admin-web",
    "seed": "tsx scripts/seed-demo.ts",
    "migrate": "npm run migrate --workspace=@tea-ledger/database"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
